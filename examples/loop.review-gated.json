{
  "name": "review-gated",
  "version": 2,
  "items": ["unit-001", "unit-002", "unit-003"],
  "stages": [
    {
      "name": "contract",
      "executor": "self",
      "produces": ["contracts/{item}.md"],
      "gate": { "artifact": true },
      "instructions": "docs/stages/contract.md",
      "batchable": { "max": 3 }
    },
    {
      "name": "implement",
      "executor": "implementer-agent",
      "with": { "styleguide": "docs/style.md" },
      "produces": ["src/{item}/*"],
      "gate": { "run": "npm run typecheck" },
      "instructions": "docs/stages/implement.md"
    },
    {
      "name": "review",
      "executor": "reviewer-agent",
      "produces": ["reports/{item}-review.json"],
      "gate": {
        "run": "jq -e '.verdict==\"PASS\"' reports/{item}-review.json",
        "expects": "review verdict JSON with a top-level verdict field"
      },
      "onFail": "implement",
      "approval": { "graduation": { "afterCleanPasses": 3, "resetOn": "new-findings" } }
    },
    {
      "name": "verify",
      "executor": "self",
      "produces": [],
      "gate": { "run": "npm test -- {item}" }
    }
  ],
  "policy": { "parallel": 2, "maxAttempts": 3 }
}
